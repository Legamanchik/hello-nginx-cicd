#!/usr/bin/env bash
set -Eeuo pipefail
exec > >(tee -a /var/log/bootstrap-k3s.log) 2>&1

PUBLIC_IP="${public_ip}"
K3S_VERSION="${k3s_version}"
ARGOCD_VERSION="${argocd_version}"
ARGOCD_NODEPORT="${argocd_nodeport}"

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export PATH=$PATH:/usr/local/bin

echo "==> Swap (2 GB): k3s + Argo CD on a 2 GB node"
if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

echo "==> Installing k3s $K3S_VERSION"
curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION="$K3S_VERSION" \
  INSTALL_K3S_SKIP_SELINUX_RPM=true \
  sh -s - server \
    --tls-san "$PUBLIC_IP" \
    --write-kubeconfig-mode 0600

until kubectl get nodes >/dev/null 2>&1; do sleep 3; done
kubectl wait --for=condition=Ready node --all --timeout=300s

echo "==> Installing Argo CD $ARGOCD_VERSION"
kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
kubectl apply -n argocd --server-side --force-conflicts \
  -f "https://raw.githubusercontent.com/argoproj/argo-cd/$ARGOCD_VERSION/manifests/install.yaml"

kubectl -n argocd scale deployment argocd-dex-server argocd-notifications-controller \
  argocd-applicationset-controller --replicas=0

kubectl -n argocd patch configmap argocd-cm --type merge \
  -p '{"data":{"timeout.reconciliation":"60s"}}'

kubectl -n argocd patch service argocd-server --type merge -p "{
  \"spec\": {\"type\": \"NodePort\", \"ports\": [
    {\"name\": \"http\",  \"port\": 80,  \"targetPort\": 8080},
    {\"name\": \"https\", \"port\": 443, \"targetPort\": 8080, \"nodePort\": $ARGOCD_NODEPORT}
  ]}}"

kubectl -n argocd rollout restart statefulset argocd-application-controller
kubectl -n argocd rollout status deployment argocd-server --timeout=600s
kubectl -n argocd rollout status deployment argocd-repo-server --timeout=600s
kubectl -n argocd rollout status statefulset argocd-application-controller --timeout=600s

echo "==> Registering the hello-nginx Application"
cat <<'MANIFEST' | kubectl apply -f -
${application_manifest}
MANIFEST

echo "==> kubeconfig for ec2-user"
install -d -o ec2-user -g ec2-user -m 700 /home/ec2-user/.kube
install -o ec2-user -g ec2-user -m 600 /etc/rancher/k3s/k3s.yaml /home/ec2-user/.kube/config

echo "==> Bootstrap complete"
